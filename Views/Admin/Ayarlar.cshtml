@model  Restorant_Sitesi.Models.USTILETISIM
@{
    ViewBag.Title = "Ayarlar";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<h2>Ayarlar</h2>

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="fa-solid fa-gears me-2"></i>Üst İletişim Ayarları</h5>
            <span class="badge bg-light text-primary">ID: @(Model?.UstID ?? 1)</span>
        </div>
        
        <div class="card-body">
            @using (Html.BeginForm("UstIletisimGuncelle", "Ayarlar", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="UstID" value="@(Model?.UstID ?? 1)" />

                <h6 class="text-muted border-bottom pb-2 mb-3">Temel İletişim Bilgileri</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Telefon" class="form-label fw-bold">Telefon Numarası</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                            <input type="text" class="form-control" id="Telefon" name="Telefon" value="@Model?.Telefon" placeholder="Örn: +90 555 555 55 55" required>
                        </div>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label for="Mail" class="form-label fw-bold">E-Posta Adresi</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                            <input type="email" class="form-control" id="Mail" name="Mail" value="@Model?.Mail" required>
                        </div>
                    </div>

                    <div class="col-12 mb-4">
                        <label for="AcilisKapanis" class="form-label fw-bold">Çalışma Saatleri (Açılış - Kapanış)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-clock"></i></span>
                            <input type="text" class="form-control" id="AcilisKapanis" name="AcilisKapanis" value="@Model?.AcilisKapanis" required>
                        </div>
                    </div>
                </div>

                <h6 class="text-muted border-bottom pb-2 mb-3 mt-2">Sosyal Medya Bağlantıları</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Facebook" class="form-label fw-bold">Facebook URL</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-brands fa-facebook text-primary"></i></span>
                            <input type="text" class="form-control" id="Facebook" name="Facebook" value="@Model?.Facebook">
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="Instagram" class="form-label fw-bold">Instagram URL</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-brands fa-instagram text-danger"></i></span>
                            <input type="text" class="form-control" id="Instagram" name="Instagram" value="@Model?.Instagram">
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="Twitter" class="form-label fw-bold">Twitter (X) URL</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-brands fa-twitter text-info"></i></span>
                            <input type="text" class="form-control" id="Twitter" name="Twitter" value="@Model?.Twitter">
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="Linkedin" class="form-label fw-bold">LinkedIn URL</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-brands fa-linkedin text-primary"></i></span>
                            <input type="text" class="form-control" id="Linkedin" name="Linkedin" value="@Model?.Linkedin" placeholder="Boş (NULL)">
                        </div>
                    </div>
                </div>

                <h6 class="text-muted border-bottom pb-2 mb-3 mt-2">Yayın Durumu</h6>
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" role="switch" id="Durum" name="Durum" value="true" @(Model?.Durum == true ? "checked" : "")>
                            <label class="form-check-label fs-6 mt-1 ms-2" for="Durum">Aktif (Kullanıcı arayüzünde gösterilsin mi?)</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <button type="reset" class="btn btn-secondary">İptal</button>
                    <button type="submit" class="btn btn-success"><i class="fa-solid fa-save me-2"></i>Ayarları Kaydet</button>
                </div>
            }
        </div>
    </div>
</div>